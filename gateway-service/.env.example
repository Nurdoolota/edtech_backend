SERVER_PORT=8080

# Must match the same JWT_SECRET used in auth-service
JWT_SECRET=your_long_random_secret_here

# Downstream service base URLs (no trailing slash)
AUTH_SERVICE_URL=http://localhost:8081
CONTENT_SERVICE_URL=http://localhost:8082
LEARNING_SERVICE_URL=http://localhost:8083

# CORS: allow only the frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting: max requests per second per IP
RATE_LIMIT_RPS=20
